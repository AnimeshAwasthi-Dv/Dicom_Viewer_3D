HOST=0.0.0.0
PORT=3000
PUBLIC_URL=https://viewer.example.com
# Generate with: openssl rand -hex 32. Keep only on the two servers.
SERVICE_API_KEY=replace-with-a-random-secret-at-least-32-characters
REDIS_URL=rediss://default:replace-password@your-redis-host:6379/0
REDIS_CLUSTER_MODE=true
AWS_REGION=ap-south-1
S3_BUCKET=decxpert-studies
S3_SOURCE_PREFIX=CT/
S3_DERIVED_PREFIX=viewer-derived/
S3_CT_STUDIES_BUCKET=decxpert-studies
S3_CT_STUDIES_PREFIX=CT/
S3_MRI_STUDIES_BUCKET=decxpert-mri
S3_MRI_STUDIES_PREFIX=MRI/
S3_XRAY_STUDIES_BUCKET=decxpert-xray
S3_XRAY_STUDIES_PREFIX=Xray/
S3_MAMMOGRAPHY_STUDIES_BUCKET=decxpert-mammography
S3_MAMMOGRAPHY_STUDIES_PREFIX=Mammography/
SESSION_TTL_SECONDS=3600
# Sites allowed to embed the viewer in an iframe (space-separated origins). Leave unset to allow any.
# FRAME_ANCESTORS=https://portal.example.com
MAX_ZIP_BYTES=8589934592
MAX_ENTRY_BYTES=134217728
MAX_EXPANDED_BYTES=34359738368
MAX_ZIP_ENTRIES=20000
