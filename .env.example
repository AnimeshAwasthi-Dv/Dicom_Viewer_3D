HOST=0.0.0.0
PORT=3000
PUBLIC_URL=https://dicom.admindectrocel.online
# Generate with: openssl rand -hex 32. Keep only on the two servers.
SERVICE_API_KEY=replace-with-a-random-secret-at-least-32-characters
# API and worker must share this persistent local directory. No Redis service is needed.
VIEWER_DATA_DIR=data
AWS_REGION=us-east-1
S3_BUCKET=animesh-arn
S3_SOURCE_PREFIX=test/hospitals/
S3_ADDITIONAL_SOURCE_PREFIXES=test/studies/
S3_DERIVED_PREFIX=test/viewer-derived/
# All modalities use the shared source locations above unless BOTH overrides are set.
# S3_CT_STUDIES_BUCKET=animesh-arn
# S3_CT_STUDIES_PREFIX=test/hospitals/
# Prefer an EC2 IAM role. If using rotated access keys, put them ONLY in the server's untracked .env:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
SESSION_TTL_SECONDS=3600
MAX_ZIP_BYTES=8589934592
MAX_ENTRY_BYTES=134217728
MAX_EXPANDED_BYTES=34359738368
MAX_ZIP_ENTRIES=20000
