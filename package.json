{
  "name": "decxpert-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && esbuild server/index.ts server/worker.ts --bundle --platform=node --format=esm --packages=external --outdir=server-dist",
    "dev:api": "tsx --env-file=.env server/index.ts",
    "dev:worker": "tsx --env-file=.env server/worker.ts",
    "start": "node server-dist/index.js",
    "start:worker": "node server-dist/worker.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@cornerstonejs/codec-charls": "^1.2.5",
    "@cornerstonejs/codec-openjpeg": "^1.3.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "compression": "^1.8.2",
    "dicom-parser": "^1.8.21",
    "express": "^5.2.1",
    "image-size": "^2.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "unzipper": "^0.12.5",
    "vite": "^5.4.11",
    "zod": "^4.6.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
